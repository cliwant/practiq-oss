generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["practiq"]
}

// ─── Auth (NextAuth.js) ──────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  passwordHash  String?   @map("password_hash")
  image         String?

  // Firm metadata (seeded from signup form, editable in /settings)
  firmName        String? @map("firm_name")
  firmVertical    String? @map("firm_vertical") // accounting | law | consulting | hr | agency | advisory | other
  timezone        String  @default("America/New_York")
  briefingEnabled Boolean @default(true) @map("briefing_enabled")
  briefingHour    Int     @default(2) @map("briefing_hour") // local hour for nightly briefing (0-23)

  // Billing (Stripe)
  stripeCustomerId String? @unique @map("stripe_customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts              Account[]
  sessions              Session[]
  clients               Client[]
  conversations         Conversation[]
  outputs               Output[]
  fileUploads           FileUpload[]
  contexts              ClientContext[]
  agentTasks            AgentTask[]
  approvalItems         ApprovalItem[]
  assignedApprovalItems ApprovalItem[]      @relation("ApprovalItemAssignee")
  agentRules            AgentRule[]
  subscription          Subscription?
  usage                 UsageEvent[]
  analyticsEvents       AnalyticsEvent[]
  sentInvites           TeamInvite[]        @relation("InviteSender")
  clientMemberships     UserClientMapping[]
  verificationTokens    VerificationToken[]
  clientFacts           ClientFact[]

  @@map("users")
  @@schema("practiq")
}

/**
 * Subscription — one active subscription per user (single-seat model
 * for MVP; team plans carry seat counts in the Stripe price object,
 * not in the Practiq schema).
 */
model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  stripePriceId        String   @map("stripe_price_id")
  plan                 String // starter | team | pro
  status               String // trialing | active | past_due | canceled | incomplete
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  seatCount            Int      @default(1) @map("seat_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
  @@schema("practiq")
}

/**
 * UsageEvent — every Claude call logged with input/output tokens so we
 * can surface usage in /settings/billing and trigger rate-limit warnings
 * for users near plan caps.
 */
model UsageEvent {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  kind         String // chat | agent_run | artifact_generate | context_extract
  agentType    String?  @map("agent_type")
  clientId     String?  @map("client_id")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  provider     String // sdk | cli
  model        String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([clientId])
  @@map("usage_events")
  @@schema("practiq")
}

/**
 * UserClientMapping — many-to-many between users and clients for team
 * collaboration. Role defines permission scope; primary owner is the
 * user on Client.userId (preserved for single-owner default).
 */
model UserClientMapping {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  clientId String   @map("client_id")
  role     String   @default("member") // owner | member | viewer
  addedAt  DateTime @default(now()) @map("added_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@map("user_client_mappings")
  @@schema("practiq")
}

/**
 * TeamInvite — pending email invitation to join a firm's workspace
 * with access to a set of clients. Consumed when the invitee signs
 * up with the same email.
 */
model TeamInvite {
  id         String    @id @default(uuid())
  senderId   String    @map("sender_id")
  email      String
  role       String    @default("member") // owner | member | viewer
  clientIds  Json      @default("[]") @map("client_ids") // string[] of clientIds, empty = all
  token      String    @unique // used in invite URL
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  sender User @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@map("team_invites")
  @@schema("practiq")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("practiq")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("practiq")
}

/**
 * VerificationToken — generic one-time token table covering both
 * email verification and password reset. Distinguished by `kind`:
 * - "verify_email" — proves the email address is reachable
 * - "password_reset" — one-time pad for resetting a forgotten pw
 * Token strings are 32-byte random base64url (URL-safe). TTL is
 * enforced at consume time; the index on expiresAt lets a cron
 * sweep the stale rows.
 */
model VerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  kind       String // "verify_email" | "password_reset"
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
  @@map("verification_tokens")
  @@schema("practiq")
}

// ─── Business Domain ─────────────────────────────────────

model Client {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  name               String
  industry           String
  userRole           String   @map("user_role")
  relationshipMonths Int      @default(0) @map("relationship_months")
  preferences        Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contexts      ClientContext[]
  conversations Conversation[]
  outputs       Output[]
  fileUploads   FileUpload[]
  agentTasks    AgentTask[]
  approvalItems ApprovalItem[]
  agentRules    AgentRule[]
  teamMembers   UserClientMapping[]
  clientFacts   ClientFact[]

  @@index([userId])
  @@map("clients")
  @@schema("practiq")
}

model ClientContext {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  title     String
  content   String
  /// pgvector embedding (1024 dims, cohere-embed-english-v3.0). Read /
  /// written via raw SQL in src/lib/embeddings.ts; Unsupported type
  /// keeps Prisma client out of vector serialization while letting it
  /// know the column exists for migrations + introspection.
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")
  category  String
  tags      String[] @default([])
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@index([clientId])
  @@index([clientId, category])
  @@map("client_contexts")
  @@schema("practiq")
}

model Conversation {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  userId    String   @map("user_id")
  title     String?
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id])
  messages ConversationMessage[]

  @@index([clientId])
  @@map("conversations")
  @@schema("practiq")
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  attachments    Json     @default("[]")
  toolCalls      Json?    @map("tool_calls")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
  @@schema("practiq")
}

model Output {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  userId           String   @map("user_id")
  title            String
  format           String
  filePath         String   @map("file_path")
  fileSizeBytes    BigInt?  @map("file_size_bytes")
  version          Int      @default(1)
  parentOutputId   String?  @map("parent_output_id")
  generatedBy      String   @map("generated_by")
  generationPrompt String?  @map("generation_prompt")
  isLatest         Boolean  @default(true) @map("is_latest")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
  parentOutput Output?  @relation("OutputVersions", fields: [parentOutputId], references: [id])
  childOutputs Output[] @relation("OutputVersions")

  @@index([clientId])
  @@map("outputs")
  @@schema("practiq")
}

model FileUpload {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  userId           String   @map("user_id")
  originalFilename String   @map("original_filename")
  filePath         String   @map("file_path")
  fileSizeBytes    BigInt?  @map("file_size_bytes")
  mimeType         String?  @map("mime_type")
  parsingStatus    String   @default("pending") @map("parsing_status")
  createdAt        DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@map("file_uploads")
  @@schema("practiq")
}

// ─── AI-Native Agent Orchestration ──────────────────────────

/// Every background agent execution leaves a record here: what it looked
/// at, what it produced (if anything), and how confident it was. Used
/// for debugging, for audit trails, and as the source for the agent-
/// activity feed in the UI.
model AgentTask {
  id           String    @id @default(uuid())
  clientId     String    @map("client_id")
  userId       String    @map("user_id")
  agentType    String    @map("agent_type") // daily_briefing | anomaly_detector | close_prep | comms_drafter
  status       String    @default("pending") // pending | running | completed | failed | skipped
  input        Json      @default("{}")
  output       Json      @default("{}")
  summary      String? // short human-readable result
  confidence   Float? // 0.0 - 1.0
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // RUN 14 (P2-01 hardening): idempotency / retry / cost / version
  // -------------------------------------------------------------
  // dedupKey  : opaque dispatcher-controlled key that maps to "same
  //             intended run" (e.g. `${clientId}::${agentType}::YYYY-MM-DD`).
  //             Indexed but NOT unique — the dispatcher's pre-flight
  //             query handles dedup; concurrent dispatch invocations
  //             may race for ~ms, accepted tradeoff vs the complexity
  //             of a unique-index race-recovery path.
  // attempt   : 0 for the first try, 1+ for transient retries. Lets us
  //             keep one row per attempt so failure modes (network 5xx
  //             vs parse error) remain auditable.
  // usdCost   : final billable USD computed from provider-reported
  //             input + output tokens × spend-ceiling PRICING table.
  //             Surfaced in /api/approval-queue and the activity feed
  //             so operators can see "this briefing cost $0.22".
  // agentVersion: version string from AgentDefinition.version. Lets
  //             us correlate prompt-change deploys with output drift
  //             without keeping a code-version-by-date table.
  dedupKey     String?   @map("dedup_key")
  attempt      Int       @default(0)
  usdCost      Decimal?  @map("usd_cost") @db.Decimal(10, 4)
  agentVersion String?   @map("agent_version")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  approvalItems ApprovalItem[]

  @@index([clientId])
  @@index([status])
  @@index([agentType, status])
  @@index([userId, dedupKey, status])
  @@map("agent_tasks")
  @@schema("practiq")
}

/// The core of the AI-Native pattern: AI produces drafts, the operator
/// approves or corrects. Every AI-generated deliverable lives here
/// until a human decides its fate.
model ApprovalItem {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  agentTaskId   String?   @map("agent_task_id")
  type          String // financial_statement | tax_summary | email_draft | anomaly_alert | briefing | reminder
  title         String
  status        String    @default("pending_review") // pending_review | approved | rejected | modified | dismissed
  priority      Int       @default(0) // 0-100 urgency score
  aiConfidence  Float?    @map("ai_confidence")
  content       Json // the actual deliverable payload
  aiNotes       String?   @map("ai_notes")
  reviewerNotes String?   @map("reviewer_notes")
  reviewedAt    DateTime? @map("reviewed_at")
  deadline      DateTime? // when this item loses value
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Team-tier routing — assign approval to a specific teammate. The
  // assignee must have a UserClientMapping for the parent Client; the
  // app layer enforces that, the schema only owns the FK.
  assigneeId String?   @map("assignee_id")
  assignedAt DateTime? @map("assigned_at")

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
  agentTask AgentTask? @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("ApprovalItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId, status])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@map("approval_items")
  @@schema("practiq")
}

/// Learned automation rules. When the operator approves a draft with
/// modifications, the pattern learner stores the shape of the edit here
/// so future drafts apply it automatically.
model AgentRule {
  id           String   @id @default(uuid())
  clientId     String?  @map("client_id") // null = user-global rule
  userId       String   @map("user_id")
  ruleType     String   @map("rule_type") // categorization | formatting | communication_tone | threshold
  condition    Json // when to apply
  action       Json // what to do
  confidence   Float    @default(0.5)
  appliedCount Int      @default(0) @map("applied_count")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId, enabled])
  @@map("agent_rules")
  @@schema("practiq")
}

/// Compliance trail. Every AI judgment and every human decision is
/// logged here for regulator queries and for debugging drift.
model AuditLog {
  id        String   @id @default(uuid())
  clientId  String?  @map("client_id")
  userId    String?  @map("user_id")
  agentType String?  @map("agent_type")
  action    String // agent_detection | approval_created | approved | rejected | modified | rule_learned
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("practiq")
}

/// FoundingSlot — single-row counter the Stripe checkout flow uses to
/// claim a Founding Member spot atomically. Stripe webhook should
/// `UPDATE … SET claimed_count = claimed_count + 1 WHERE id = 'singleton'
/// AND claimed_count < cap` and only proceed if rowcount = 1, so the
/// 50-spot limit is enforced by the database, not by app code racing
/// against itself.
model FoundingSlot {
  id           String   @id @default("singleton")
  claimedCount Int      @default(0) @map("claimed_count")
  cap          Int      @default(50)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("founding_slots")
  @@schema("practiq")
}

/// AnalyticsEvent — self-hosted product analytics. Replaces the PostHog
/// dependency so we keep all customer behavioural data in our own
/// Supabase, queryable via SQL, no external vendor cost or data exit.
///
/// Two write paths:
///   - server-side: src/lib/analytics/track.ts → prisma.analyticsEvent.create
///     (signup_completed, checkout_initiated, checkout_completed,
///     subscription_canceled, chat_started, plan_gate_blocked, …)
///   - client-side: src/lib/analytics/track-client.ts beacon →
///     POST /api/events → prisma.analyticsEvent.create
///     ($pageview, pricing_cta_clicked, signup_form_submitted, …)
///
/// `distinctId` is the cookie-persisted anon visitor id when the user
/// is not signed in, the User.id when they are. `userId` (FK) is set
/// only when authenticated so the analytics dashboard can join across
/// behaviour + subscription + usage cleanly without leaking anon
/// sessions.
///
/// `properties` is a free-form JSON column — the tracked-event taxonomy
/// is defined in src/lib/analytics/event-types.ts (keep there in sync).
///
/// UTM columns are first-touch attribution. The client beacon promotes
/// utm_* into typed columns instead of nesting in `properties` so we can
/// SQL-aggregate `count(*) GROUP BY utm_source` without a JSON path scan.
model AnalyticsEvent {
  id          String   @id @default(uuid())
  type        String
  distinctId  String?  @map("distinct_id")
  userId      String?  @map("user_id")
  properties  Json     @default("{}")
  url         String?
  referrer    String?
  userAgent   String?  @map("user_agent")
  ipHash      String?  @map("ip_hash")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  utmTerm     String?  @map("utm_term")
  utmContent  String?  @map("utm_content")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
  @@index([distinctId])
  @@index([utmSource, utmCampaign])
  @@map("analytics_events")
  @@schema("practiq")
}

// ─── Temporal Knowledge Graph (P1-02) ────────────────────────
//
// The "moat" — atomized facts about each client with explicit
// validity windows. Unlike a single mutable Client.preferences
// blob, this lets us answer "what did we believe about this
// client on 2026-03-15?" by filtering on validFrom/validUntil,
// and lets the agent reason over a graph of how facts relate.
//
// validFrom / validUntil — bi-temporal validity. A fact is
// "active" when validUntil IS NULL OR validUntil > asOf.
// supersededBy — link to the new ClientFact that replaced this
// one when the operator (or an agent) recorded a contradicting
// statement; the old row is kept so we never lose history.

/// A single atomic fact about a client, time-bounded with
/// validFrom/validUntil so we can replay belief state at any
/// point. Confidence is normalized 0..1; sources are coarse-
/// grained (agent_extracted | user_input | document_parsed |
/// conversation) so the UI can group and audit.
model ClientFact {
  id           String    @id @default(uuid())
  clientId     String    @map("client_id")
  userId       String    @map("user_id")
  /// 사실 카테고리: financial | preference | strategic | relationship | risk
  category     String
  /// 사실의 핵심 내용 (자연어, ~120자)
  statement    String
  /// 신뢰도 0~1
  confidence   Float     @default(0.7)
  /// 출처: agent_extracted | user_input | document_parsed | conversation
  source       String
  sourceRef    String?   @map("source_ref")
  validFrom    DateTime  @default(now()) @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  supersededBy String?   @map("superseded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id])
  outgoingEdges FactEdge[] @relation("EdgeFrom")
  incomingEdges FactEdge[] @relation("EdgeTo")

  @@index([clientId, validUntil])
  @@index([userId, category])
  @@map("client_facts")
  @@schema("practiq")
}

/// Directed edge between two ClientFacts. The graph captures
/// how facts relate: causes (A → B), contradicts (A vs B,
/// usually paired with supersededBy), refines (A is a more
/// specific version of B), depends_on (A is true given B), or
/// follows (A came after B chronologically). Weight is a
/// pluggable importance score; the unique key on
/// (from, to, relation) prevents duplicate edges of the same
/// kind between the same pair.
model FactEdge {
  id         String   @id @default(uuid())
  fromFactId String   @map("from_fact_id")
  toFactId   String   @map("to_fact_id")
  /// 관계 종류: causes | contradicts | refines | depends_on | follows
  relation   String
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now()) @map("created_at")

  fromFact ClientFact @relation("EdgeFrom", fields: [fromFactId], references: [id], onDelete: Cascade)
  toFact   ClientFact @relation("EdgeTo", fields: [toFactId], references: [id], onDelete: Cascade)

  @@unique([fromFactId, toFactId, relation])
  @@index([fromFactId])
  @@index([toFactId])
  @@map("fact_edges")
  @@schema("practiq")
}
