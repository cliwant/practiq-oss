# PostgreSQL (로컬)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fractional

# LLM provider — src/lib/claude/provider.ts picks one of these in priority order:
#   1. ANTHROPIC_API_KEY  → Anthropic direct (best when key has billing)
#   2. OPENROUTER_API_KEY → OpenRouter (single key for Anthropic+OpenAI+Google;
#                          uses /v1/messages Anthropic-shim, same Tool Use API)
#   3. neither            → Claude Code CLI (uses operator's local OAuth)
# Override with CLAUDE_PROVIDER=sdk|openrouter|cli; default 'auto' picks #1→2→3.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CLAUDE_PROVIDER=auto

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Google OAuth (NextAuth Provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FastAPI Document Service
DOCUMENT_SERVICE_URL=http://localhost:8000
