# ─────────────────────────────────────────────────────────────────────
# Practiq — environment template
# ─────────────────────────────────────────────────────────────────────
# This file is committed (in contrast to `.env.local` which is gitignored).
# Copy to `.env.local` (or stack on top of the studio-root `.env.local` per
# `dotenv -e ../../.env.local -- ...`) and fill in real values. Keep ALL
# placeholders empty here — never commit a secret.
#
# RUN 24 audit fix #14: prior version listed only 7 vars; production code
# references 60+. This rebuild aims for 100% coverage so a fresh contributor
# / auditor can see at a glance what services Practiq depends on.
#
# Section ordering: required-for-build → required-for-runtime → optional.

# ─── Database (Supabase Postgres) ─────────────────────────────────────
# Production: Supabase pooled connection. Local dev: prisma embedded server
# (port assigned by `npx prisma dev`). The ARM64 Windows path uses the Wasm
# adapter — see prisma.config.ts.
DATABASE_URL=postgresql://postgres:postgres@localhost:51218/template1?sslmode=disable
# Direct (non-pooled) Supabase URL — used by Prisma migrations and any
# script that needs `pg_advisory_lock`.
DIRECT_URL=

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Google OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn OAuth provider
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Microsoft Entra (Azure AD) OAuth provider
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=
MICROSOFT_ENTRA_ID_TENANT_ID=

# ─── LLM provider (priority order) ────────────────────────────────────
# src/lib/claude/provider.ts auto-selects:
#   1. ANTHROPIC_API_KEY  → Anthropic direct (best when key has billing)
#   2. OPENROUTER_API_KEY → OpenRouter (single key for multi-vendor)
#   3. neither            → Claude Code CLI (uses operator's local OAuth)
# RUN 16: when BOTH ANTHROPIC + OPENROUTER are set, primary=Anthropic
# direct, fallback=OpenRouter on transient 5xx. Disable with
# CLAUDE_DISABLE_FALLBACK=1.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
CLAUDE_PROVIDER=auto
CLAUDE_DISABLE_FALLBACK=

# ─── Embeddings (pgvector backfill) ──────────────────────────────────
# Used by src/lib/embeddings.ts → backfill ClientContext.content_embedding.
# OpenAI text-embedding-3-small via OpenRouter (RUN 12). Same key as
# OPENROUTER_API_KEY above — kept distinct so a future migration to a
# dedicated embeddings vendor doesn't require a code change.

# ─── Stripe (live mode) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional — Stripe customer portal config + price IDs are read from
# the live Stripe account at runtime.

# ─── Resend (transactional email) ────────────────────────────────────
RESEND_API_KEY=
# Resend webhook (RUN 11) — Svix-signed delivery events.
RESEND_WEBHOOK_SECRET=
# Optional kill switch for the 60s polling fallback.
RESEND_DELIVERY_POLLING_DISABLED=

# ─── Supabase (auth-adjacent uses + storage) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Slack (operator alerts) ─────────────────────────────────────────
# All `notifySlack` calls go to this single webhook. Per-type formatters
# live in src/lib/notifications/slack.ts.
SLACK_WEBHOOK_URL=

# ─── PostHog (analytics — being phased out for OSS observability) ───
# RUN 19 added Plausible + structured logger + Prometheus metrics as
# the OSS replacement. PostHog continues to coexist during the
# migration window so the historical event stream stays intact.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=

# ─── Plausible Analytics (OSS replacement, RUN 19) ─────────────────
# Domain registered in your Plausible dashboard (e.g. `practiq.dev`).
# When unset, the script tag is suppressed and no analytics fire.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional override for self-hosted Plausible (e.g.
# https://stats.practiq.dev). Defaults to https://plausible.io (cloud).
NEXT_PUBLIC_PLAUSIBLE_HOST=

# ─── Structured logging level (RUN 19) ─────────────────────────────
# `debug | info | warn | error`. Production defaults to info. Override
# via NODE_LOG_LEVEL when debugging a specific issue. NODE_LOG_PRETTY=1
# forces the pretty-print (emoji-tag) output even in production logs;
# leave unset for JSON-line logs that Vercel + OSS log sinks parse.
NODE_LOG_LEVEL=
NODE_LOG_PRETTY=

# ─── Vercel (KV rate limit) ──────────────────────────────────────────
# When unset, src/lib/rate-limit.ts falls back to in-memory adapter.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Cron auth ───────────────────────────────────────────────────────
# Either CRON_SECRET (Vercel newer scheme) or SEO_DEPLOY_SECRET (legacy)
# must be set for cron / dev-test routes.
CRON_SECRET=
SEO_DEPLOY_SECRET=
# Bootstrap secret for /api/dev-test/* endpoints.
BOOTSTRAP_SECRET=

# ─── SEO submission services ─────────────────────────────────────────
# Google Search Console API for sitemap submission.
GOOGLE_SEARCH_CONSOLE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Bing IndexNow key (~32-char hex).
BING_API_KEY=
INDEXNOW_KEY=
# Optional override for the IndexNow endpoint.
INDEXNOW_HOST=

# ─── Outbound SDR (Apollo + Gmail Send-As) ───────────────────────────
# Apollo for prospecting list builds + optional CRM sync.
APOLLO_API_KEY=
# Instantly — DEPRECATED 2026-05-08. Pivoted to manual Gmail Send-As
# (seungdo.keum@practiq.dev) for cold outreach. Subscription cancelled.
# These vars are kept for archive reference only; the webhook route
# (src/app/api/webhooks/instantly/route.ts) and lead-gen scripts under
# scripts/lead-gen/ remain in the repo as historical reference but no
# active code path requires these values to be populated.
# See ventures/fractional-ai-command-center/.cycle/marketing/2026-05-07-cold-outreach-playbook.md
# for the manual send protocol that replaces Instantly.
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
# AWS SES for early-access confirmation emails.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=
SES_FROM_EMAIL=

# ─── Content marketing ───────────────────────────────────────────────
# Optional video pipeline keys — content-marketer agent only.
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── Document service (deprecated) ───────────────────────────────────
# Earlier design routed .docx/.xlsx generation to a Python FastAPI side
# car. RUN 9 migrated to in-process zero-storage docx + exceljs, so this
# var is unused but kept for the docs spec.
DOCUMENT_SERVICE_URL=http://localhost:8000

# ─── Dogfood / capture ───────────────────────────────────────────────
DOGFOOD_EMAIL=
DOGFOOD_PASSWORD=

# ─── Audit / observability ───────────────────────────────────────────
# Optional explicit override for audit-shadow file root. When unset,
# defaults to /tmp/practiq-shadow on Vercel and ./storage in local dev.
# The DB AuditLog is the system of record; this is the convenience copy.
AUDIT_SHADOW_ROOT=

# ─── Feature flags / kill switches ───────────────────────────────────
# Disable the per-firm spend ceiling guard (emergency only).
SPEND_CEILING_DISABLED=

# ─── Site / SEO public ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://practiq.dev

# ─── Admin auth ──────────────────────────────────────────────────────
# Cookie-based admin gate at admin.grindworks.ai.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
