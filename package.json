{
  "name": "fractional-ai-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -o -e ../../.env.local -- next dev --turbopack",
    "dev:preview": "dotenv -o -e ../../.env.local -- next dev --webpack",
    "build": "prisma generate && node scripts/db-sync-on-deploy.mjs && dotenv -o -e ../../.env.local -- next build",
    "start": "dotenv -o -e ../../.env.local -- next start",
    "db:sync": "prisma db push --accept-data-loss --skip-generate",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "dotenv -o -e ../../.env.local -e .env -- vitest run",
    "test:watch": "dotenv -o -e ../../.env.local -e .env -- vitest",
    "test:ui": "dotenv -o -e ../../.env.local -e .env -- vitest --ui",
    "test:e2e": "dotenv -o -e ../../.env.local -e .env -- node tests/e2e/run-all.mjs",
    "capture:dashboard": "dotenv -o -e ../../.env.local -- tsx scripts/capture-dashboard.ts",
    "seed:dogfood": "dotenv -o -e ../../.env.local -- tsx scripts/seed-dogfood.ts",
    "eval:live": "dotenv -o -e ../../.env.local -- tsx scripts/eval-live.ts",
    "aeo:lint": "tsx scripts/aeo/definition-lint.ts",
    "postinstall": "node ../../scripts/fix-arm64-deps.js 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-ses": "^3.1029.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.30",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.20.0",
    "pizzip": "^3.2.0",
    "playwright": "^1.59.1",
    "posthog-js": "^1.372.9",
    "posthog-node": "^5.33.3",
    "pptxgenjs": "^3.12.0",
    "prisma": "^7.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "googleapis": "^144.0.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
